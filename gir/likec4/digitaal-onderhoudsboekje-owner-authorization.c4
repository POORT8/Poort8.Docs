// view: dob_phase1
model {
  digitaal_onderhoudsboekje_owner_authorization_ni = actor 'New Installation Service Company'
  digitaal_onderhoudsboekje_owner_authorization_app = system 'TN GIR App'
  digitaal_onderhoudsboekje_owner_authorization_keyper = system 'Keyper'
  digitaal_onderhoudsboekje_owner_authorization_owner = actor 'Building Owner'
  digitaal_onderhoudsboekje_owner_authorization_gir = system 'GIR'
}

views {
  dynamic view dob_phase1 {
    title 'Phase 1 — Owner Authorization'
    variant sequence

    digitaal_onderhoudsboekje_owner_authorization_ni -> digitaal_onderhoudsboekje_owner_authorization_app 'Submit request (owner, building, scope, validity)'
    digitaal_onderhoudsboekje_owner_authorization_app -> digitaal_onderhoudsboekje_owner_authorization_keyper 'Approval request'
    digitaal_onderhoudsboekje_owner_authorization_keyper -> digitaal_onderhoudsboekje_owner_authorization_owner 'Approval link by email'
    digitaal_onderhoudsboekje_owner_authorization_owner -> digitaal_onderhoudsboekje_owner_authorization_keyper 'Authenticate via eHerkenning and approve'
    digitaal_onderhoudsboekje_owner_authorization_keyper -> digitaal_onderhoudsboekje_owner_authorization_gir 'Register AccessRight policy (owner → New Installation Service Company)'
    digitaal_onderhoudsboekje_owner_authorization_keyper -> digitaal_onderhoudsboekje_owner_authorization_app 'Confirmation'
    digitaal_onderhoudsboekje_owner_authorization_app -> digitaal_onderhoudsboekje_owner_authorization_ni 'Confirmation'
  }
}
