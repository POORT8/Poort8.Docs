// view: registrar_keyper_approval
model {
  registrar_keyper_approval_app = actor 'Your Application'
  registrar_keyper_approval_keyper = system 'Keyper'
  registrar_keyper_approval_owner = actor 'Installation Owner'
  registrar_keyper_approval_gir = system 'GIR'
}

views {
  dynamic view registrar_keyper_approval {
    title 'Keyper Approval'
    variant sequence

    registrar_keyper_approval_app -> registrar_keyper_approval_keyper 'Create approval link'
    registrar_keyper_approval_keyper -> registrar_keyper_approval_owner 'Send approval request'
    registrar_keyper_approval_owner -> registrar_keyper_approval_keyper 'Authenticate and approve'
    registrar_keyper_approval_keyper -> registrar_keyper_approval_gir 'Register write policy'
  }
}
