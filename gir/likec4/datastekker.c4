// view: datastekker_overview
model {
  datastekker_form = system 'TechniekNederland Form'
  datastekker_keyper = system 'Keyper'
  datastekker_owner = actor 'Building Owner'
  datastekker_gir = system 'GIR'
  datastekker_ds = system 'Datastekker (2BA)'
  datastekker_inst = actor 'Installer'
}

views {
  dynamic view datastekker_overview {
    title 'Datastekker – Installer Access Flow'
    variant sequence

    datastekker_form -> datastekker_keyper 'Create access request (vboId, installer KvK, validity)'
    datastekker_keyper -> datastekker_owner 'Approval link by email'
    datastekker_owner -> datastekker_keyper 'Authenticate and approve'
    datastekker_keyper -> datastekker_gir 'Register policy (installer ↔ vboId)'

    datastekker_inst -> datastekker_ds 'Data request with componentId'
    datastekker_ds -> datastekker_gir 'Obtain DSGO bearer token'
    datastekker_gir -> datastekker_ds 'Bearer token'
    datastekker_ds -> datastekker_gir 'GET GIRBasisdataMessage by componentID'
    datastekker_gir -> datastekker_ds 'GIRBasisdataMessage (installationId + manufacturer info)'
    datastekker_ds -> datastekker_gir 'Check delegation for installer + installationId'
    datastekker_gir -> datastekker_ds 'Delegation evidence (Permit or Deny)'
    datastekker_ds -> datastekker_inst 'Authorised performance data'
  }
}
