// view: datastekker_authorization_check
model {
  datastekker_authorization_check_inst = actor 'Installer'
  datastekker_authorization_check_ds = system 'Datastekker (2BA)'
  datastekker_authorization_check_gir = system 'GIR'
}

views {
  dynamic view datastekker_authorization_check {
    title 'Phase 3 — Authorization Check'
    variant sequence

    datastekker_authorization_check_inst -> datastekker_authorization_check_ds 'Data request with componentId'
    datastekker_authorization_check_ds -> datastekker_authorization_check_gir 'POST /api/gir/v0/gir-basisdata-messages/_search {componentIdValue}'
    datastekker_authorization_check_gir -> datastekker_authorization_check_ds 'GIRBasisdataMessage (installationId + manufacturer info)'
    datastekker_authorization_check_ds -> datastekker_authorization_check_gir 'POST /v1/api/delegation — check installer + installationId'
    datastekker_authorization_check_gir -> datastekker_authorization_check_ds 'Delegation evidence (Permit or Deny)'
    datastekker_authorization_check_ds -> datastekker_authorization_check_inst 'Authorised performance data'
  }
}
