// view: registrar_step3
model {
  registrar_submit_installation_app = actor 'Your Application'
  registrar_submit_installation_gir = system 'GIR'
}

views {
  dynamic view registrar_step3 {
    title 'Step 3 — Submit Installation'
    variant sequence

    registrar_submit_installation_app -> registrar_submit_installation_gir 'POST installation payload with bearer token'
    registrar_submit_installation_gir -> registrar_submit_installation_gir 'Validate token'
    registrar_submit_installation_gir -> registrar_submit_installation_gir 'Validate schema and domain constraints'
    registrar_submit_installation_gir -> registrar_submit_installation_gir 'Check write policy for registrar and VBO-ID'
    registrar_submit_installation_gir -> registrar_submit_installation_app 'Record stored as Active or Pending'
  }
}
