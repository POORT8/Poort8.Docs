// view: dob_full_flow
model {
  digitaal_onderhoudsboekje_ni = actor 'New Installation Service Company'
  digitaal_onderhoudsboekje_app = system 'TN GIR App'
  digitaal_onderhoudsboekje_keyper = system 'Keyper'
  digitaal_onderhoudsboekje_owner = actor 'Building Owner'
  digitaal_onderhoudsboekje_gir = system 'GIR'
  digitaal_onderhoudsboekje_ni_software = system 'NI software'
  digitaal_onderhoudsboekje_prev_software = system 'Previous installation service company software'
}

views {
  dynamic view dob_full_flow {
    title 'Digitaal Onderhoudsboekje – Full Flow'
    variant sequence

    digitaal_onderhoudsboekje_ni -> digitaal_onderhoudsboekje_app 'Submit request (owner, VBO-ids, scope)'
    digitaal_onderhoudsboekje_app -> digitaal_onderhoudsboekje_keyper 'Approval request'
    digitaal_onderhoudsboekje_keyper -> digitaal_onderhoudsboekje_owner 'Approval link'
    digitaal_onderhoudsboekje_owner -> digitaal_onderhoudsboekje_keyper 'Approve via eHerkenning'
    digitaal_onderhoudsboekje_keyper -> digitaal_onderhoudsboekje_gir 'Register AccessRight (owner → New Installation Service Company)'
    digitaal_onderhoudsboekje_keyper -> digitaal_onderhoudsboekje_ni 'Confirmation'
    digitaal_onderhoudsboekje_ni -> digitaal_onderhoudsboekje_app 'Supply software platform details'
    digitaal_onderhoudsboekje_app -> digitaal_onderhoudsboekje_keyper 'SupplierDelegation request'
    digitaal_onderhoudsboekje_keyper -> digitaal_onderhoudsboekje_ni 'Approval link'
    digitaal_onderhoudsboekje_ni -> digitaal_onderhoudsboekje_keyper 'Approve via eHerkenning'
    digitaal_onderhoudsboekje_keyper -> digitaal_onderhoudsboekje_gir 'Register SupplierDelegation (New Installation Service Company → NI software)'
    digitaal_onderhoudsboekje_ni -> digitaal_onderhoudsboekje_ni_software 'Delegation details + VBO-id(s)'
    digitaal_onderhoudsboekje_ni_software -> digitaal_onderhoudsboekje_prev_software 'Authenticate + request maintenance data'
    digitaal_onderhoudsboekje_prev_software -> digitaal_onderhoudsboekje_gir 'Verify AccessRight'
    digitaal_onderhoudsboekje_gir -> digitaal_onderhoudsboekje_prev_software 'Permit'
    digitaal_onderhoudsboekje_prev_software -> digitaal_onderhoudsboekje_ni_software 'Maintenance data'
  }
}
