// view: registrar_full_flow
model {
  registrar_app = actor 'Your Application'
  registrar_keyper = system 'Keyper'
  registrar_owner = actor 'Installation Owner'
  registrar_gir = system 'GIR'
  registrar_sat = system 'DSGO Participant Registry'
}

views {
  dynamic view registrar_full_flow {
    title 'Registrar Flow – End to End'
    variant sequence

    registrar_app -> registrar_keyper 'Request write access for a VBO-ID'
    registrar_keyper -> registrar_owner 'Notify owner'
    registrar_owner -> registrar_keyper 'Authenticate and approve'
    registrar_keyper -> registrar_gir 'Register write policy'
    registrar_app -> registrar_gir 'Request DSGO bearer token'
    registrar_gir -> registrar_sat 'Validate membership and certificate chain'
    registrar_sat -> registrar_gir 'Membership active'
    registrar_gir -> registrar_app 'Bearer token issued'
    registrar_app -> registrar_gir 'Submit installation data'
    registrar_gir -> registrar_app 'Record stored as Active or Pending'
  }
}
