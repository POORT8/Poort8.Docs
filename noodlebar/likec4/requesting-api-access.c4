model {
  requesting_api_access_david = actor 'David (Consumer)'
  requesting_api_access_portal = system 'Self-Service Portal'
  requesting_api_access_charlie = actor 'Charlie (Provider)'
  requesting_api_access_asr = system 'Association Registry'
  requesting_api_access_api = system "Charlie's API"
}

views {
  dynamic view requesting_api_access {
    title 'Requesting API access'
    variant sequence

    requesting_api_access_david -> requesting_api_access_portal '1. Register application'
    requesting_api_access_portal -> requesting_api_access_asr 'Create APP client'
    requesting_api_access_asr -> requesting_api_access_portal 'Client registered'
    requesting_api_access_portal -> requesting_api_access_david 'Client credentials'

    requesting_api_access_david -> requesting_api_access_portal '2. Browse catalogue and request access'
    requesting_api_access_portal -> requesting_api_access_charlie 'Access request notification'

    requesting_api_access_charlie -> requesting_api_access_portal '3. Approve access'
    requesting_api_access_portal -> requesting_api_access_asr 'Assign API scope to APP'

    requesting_api_access_david -> requesting_api_access_asr '4. Request token (client_credentials)'
    requesting_api_access_asr -> requesting_api_access_david 'Access token'

    requesting_api_access_david -> requesting_api_access_api '5. Call API with Bearer token'
    requesting_api_access_api -> requesting_api_access_david 'API response'
  }
}
