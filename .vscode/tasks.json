{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docsify: Serve",
      "type": "shell",
      "command": "npx --yes docsify-cli@5.0.0 serve .",
      "group": {
        "kind": "serve",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "docsify",
        "pattern": {
          "regexp": "^Error:\\s+(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving ",
          "endsPattern": "Listening at http://localhost:3000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
